generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("admins")
}

model Doador {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  whatsapp     String
  bairro       String
  criadoEm     DateTime      @default(now()) @map("criado_em")

  // Equipamentos cadastrados
  equipamentos Equipamento[]

  // Conta de acesso (opcional para doadores antigos)
  conta        ContaDoador?

  // Endereços cadastrados
  enderecos    EnderecoDoador[]

  @@map("doadores")
}

model ContaDoador {
  id        String   @id @default(uuid())
  doadorId  String   @unique @map("doador_id")
  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em")

  // Cada conta pertence a um único doador
  doador Doador @relation(fields: [doadorId], references: [id], onDelete: Cascade)

  @@map("contas_doadores")
}

model EnderecoDoador {
  id           String   @id @default(uuid())
  doadorId     String   @map("doador_id")

  cep          String
  logradouro   String
  numero       String
  bairro       String
  cidade       String
  estado       String

  preferencial Boolean  @default(false)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  // Um doador pode possuir vários endereços
  doador Doador @relation(fields: [doadorId], references: [id], onDelete: Cascade)

  @@map("enderecos_doadores")
}

model Equipamento {
  id           String   @id @default(uuid())
  doadorId     String   @map("doador_id")
  categoria    String
  descricao    String
  fotoUrl      String?  @map("foto_url")
  status       String   @default("PENDENTE")
  destinoFinal String?  @map("destino_final")
    // Código exclusivo para acompanhar a doação
  codigoAcompanhamento String?  @unique @map("codigo_acompanhamento")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  doador Doador @relation(fields: [doadorId], references: [id])

  // Cópia imutável do endereço escolhido na criação da doação.
  // Campos opcionais para compatibilidade com equipamentos antigos e fluxo visitante.
  enderecoColetaCep        String? @map("endereco_coleta_cep")
  enderecoColetaLogradouro String? @map("endereco_coleta_logradouro")
  enderecoColetaNumero     String? @map("endereco_coleta_numero")
  enderecoColetaBairro     String? @map("endereco_coleta_bairro")
  enderecoColetaCidade     String? @map("endereco_coleta_cidade")
  enderecoColetaEstado     String? @map("endereco_coleta_estado")

  @@map("equipamentos")
}